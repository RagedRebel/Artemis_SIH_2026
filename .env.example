# ── LLM ────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_GENAI_API_KEY=your_google_ai_studio_api_key_here
# == Model Selection ==
# To use Gemini models:
# GEMINI_MODEL=gemini-2.5-pro

# # To use Ollama models (see https://google.github.io/adk-docs/agents/models/ollama/ ):
GEMINI_MODEL=minimax-m2.7:cloud
OLLAMA_API_BASE=http://localhost:11434
# ARTEMIS_LLM_PROVIDER=gemini  # force Gemini | ollama | auto (default: auto = Ollama if OLLAMA_API_BASE set)

# ── Kali Execution Service ──────────────────────────────────────
KES_URL=http://localhost:8001
KES_SECRET=change_this_to_a_strong_random_secret_32chars

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=artemis
POSTGRES_USER=artemis
POSTGRES_PASSWORD=artemis_db_secret
DATABASE_URL=postgresql://artemis:artemis_db_secret@localhost:5432/artemis

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Wazuh ───────────────────────────────────────────────────────
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=Wazuh_Ap1_S3cret!
WAZUH_VERIFY_SSL=false

# ── Admin Panel ─────────────────────────────────────────────────
NEXTAUTH_SECRET=change_this_to_a_strong_random_secret
AUTH_SECRET=change_this_to_a_strong_random_secret
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=admin@artemis.local
ADMIN_PASSWORD=admin_password_change_me

# ── Jira Integration (Atlassian OAuth 2.0) ──────────────────────
JIRA_CLIENT_ID=your_atlassian_oauth_client_id
JIRA_CLIENT_SECRET=your_atlassian_oauth_client_secret
JIRA_REDIRECT_URI=http://localhost:3000/api/integrations/jira/callback

# ── Slack Integration ────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# ── CVE Intelligence & Reconnaissance ───────────────────────────
NVD_API_KEY=your_nvd_api_key_optional_but_increases_rate_limit
GITHUB_TOKEN=your_github_token_for_poc_search
SHODAN_API_KEY=your_shodan_api_key_here
CVE_FETCH_INTERVAL_HOURS=6
CVE_MIN_CVSS_SCORE=7.0

# ── Campaign Defaults ───────────────────────────────────────────
DEFAULT_SCAN_TIMEOUT_SECONDS=300
MAX_CONCURRENT_CAMPAIGNS=3
AUTO_APPROVE_MAX_RISK=medium

# ── Wazuh Internal Credentials (Optional / SIEM specific) ───────
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_DASHBOARD_SERVER_PASSWORD=kibanaserver
WAZUH_DASHBOARD_URL=https://localhost:5601

# ── MongoDB (Admin panel users / auth optional backing) ─────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/artemis

# ── LangFuse ───────────────────────────────────
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
OTEL_EXPORTER_OTLP_HEADERS=